{
  "name": "qhago-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/examples/*",
    "bench",
    "docs-site"
  ],
  "scripts": {
    "build:wasm": "bash packages/engine-wasm/build.sh",
    "build": "bun run --filter @qhago/scanner build && bun run --filter @qhago/ai build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun run --filter '*' test",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:local": "node scripts/release.mjs --local",
    "docs": "bun run --filter qhago-docs build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.29.0",
    "semver": "^7.7.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
