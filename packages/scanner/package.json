{
  "name": "@qhago/scanner",
  "version": "0.0.0",
  "description": "Barcode & QR scanner for the web, Node and Bun — ZXing-C++ in WebAssembly, multi-frame fusion, optional AI detector.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/browser/ui.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./dist/node/index.js",
      "node": "./dist/node/index.js",
      "browser": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    },
    "./polyfill": {
      "types": "./dist/types/polyfill/index.d.ts",
      "bun": "./dist/node/polyfill.js",
      "node": "./dist/node/polyfill.js",
      "browser": "./dist/browser/polyfill.js",
      "default": "./dist/browser/polyfill.js"
    },
    "./parsers": {
      "types": "./dist/types/parsers/index.d.ts",
      "bun": "./dist/node/parsers.js",
      "node": "./dist/node/parsers.js",
      "default": "./dist/browser/parsers.js"
    },
    "./quagga-compat": {
      "types": "./dist/types/quagga-compat/index.d.ts",
      "default": "./dist/browser/quagga-compat.js"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "default": "./dist/browser/ui.js"
    },
    "./worker-host": {
      "types": "./dist/types/worker-host.d.ts",
      "default": "./dist/browser/worker-host.js"
    },
    "./wasm/*": "./wasm/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qhago/scanner.git",
    "directory": "packages/scanner"
  },
  "keywords": [
    "barcode",
    "qr",
    "qrcode",
    "scanner",
    "zxing",
    "wasm",
    "ean",
    "datamatrix",
    "pdf417",
    "barcode-detector",
    "quagga"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && node scripts/copy-wasm.mjs && tsup && tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs --dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --project node && bun test test/bun",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "api": "bun scripts/api-report.ts",
    "api:check": "bun scripts/api-report.ts --check",
    "coverage": "bash scripts/make-fake-video.sh && QHAGO_BROWSERS=chromium vitest run --coverage",
    "size": "node scripts/check-size.mjs",
    "test:e2e": "bun test e2e && node --test e2e/*.e2e.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.0",
    "@vitest/browser": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.10.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.3.0",
    "playwright": "^1.55.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
